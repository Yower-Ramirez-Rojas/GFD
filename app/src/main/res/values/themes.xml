<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal de la aplicación GFD -->
    <style name="Theme.GFD" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>

        <!-- Color principal de la app (barra superior de notificaciones) -->
        <item name="colorPrimary">@color/azul_tecnologico</item>
        <item name="colorPrimaryVariant">@color/azul_noche</item>
        <item name="colorOnPrimary">@color/blanco_puro</item>

        <!-- Color de fondo general de las pantallas -->
        <item name="android:windowBackground">@color/azul_noche</item>

        <!-- Color de textos generales -->
        <item name="android:textColor">@color/blanco_puro</item>

        <!-- Configuración de la barra de estado (Batería y hora) -->
        <item name="android:statusBarColor">@color/azul_noche</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>