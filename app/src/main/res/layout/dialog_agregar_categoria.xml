<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/blanco_puro">

    <!-- Encabezado del Cuadro -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nuevo Apartado / Gasto"
        android:textColor="@color/negro_carbon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- Recuadro 1: Nombre de la Categoría (Arriendo, Luz, etc.) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej. Arriendo, Supermercado, Luz"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/azul_tecnologico"
        app:hintTextColor="@color/azul_tecnologico">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombreCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:textColor="@color/negro_carbon"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Recuadro 2: Monto Asignado -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monto asignado ($)"
        app:boxStrokeColor="@color/azul_tecnologico"
        app:hintTextColor="@color/azul_tecnologico">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMontoCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/negro_carbon"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>