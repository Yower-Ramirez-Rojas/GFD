<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul_noche">

    <!-- Título Principal -->
    <TextView
        android:id="@+id/tvTituloLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GESTOR FINANCIERO"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/blanco_puro"
        android:letterSpacing="0.10"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Acento Tecnológico Decorativo (Línea fina azul eléctrico) -->
    <View
        android:id="@+id/lineaDecorativa"
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:background="@color/azul_tecnologico"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tarjeta Blanca Central (Estilo Material CardView) -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="64dp"
        app:cardBackgroundColor="@color/blanco_puro"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/lineaDecorativa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <!-- Texto dinámico para saludar por el correo -->
            <TextView
                android:id="@+id/tvCuentaRecordada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicia sesión para continuar"
                android:textColor="@color/negro_carbon"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <!-- Botón Principal: Huella (Fintech Style) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHuella"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Ingresar con Huella"
                android:textColor="@color/blanco_puro"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/azul_tecnologico"
                app:cornerRadius="12dp"
                app:icon="@android:drawable/ic_secure"
                app:iconGravity="textStart"
                app:iconTint="@color/blanco_puro" />

            <!-- Separador visual O -->
            <TextView
                android:id="@+id/tvSeparador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="o"
                android:textColor="@color/gris_pizarra"
                android:textSize="14sp"
                android:layout_marginVertical="12dp"/>

            <!-- Botón Secundario: Clásico / Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleClasico"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Vincular cuenta de Google"
                android:textColor="@color/negro_carbon"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>